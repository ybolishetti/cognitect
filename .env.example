# Cognitect — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# Claude API key for intent parsing (engine/intent_parser/parser.py reads
# this exact name — NOT ANTHROPIC_API_KEY)
COGNITECT_CLAUDE_API_KEY=sk-ant-api03-...

# Supabase (persistent plan store + JWT auth — /v2/plans routes)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=super-long-secret

# Rate limits for POST /v2/plans/{id}/instruct (the only endpoint that calls Claude)
ANON_RATE_LIMIT_PER_HOUR=1
USER_RATE_LIMIT_PER_DAY=20

# Local-dev-only (docker-compose + Dockerfile.dev). Not used in the Fly image
# or by any current api/ or engine/ code — Postgres here is unused today,
# kept only for local-stack parity; Supabase is the real persistence layer.
DATABASE_URL=postgresql://cognitect:cognitect@localhost:5432/cognitect

# Redis connection string (used by the Celery broker + backend)
REDIS_URL=redis://localhost:6379/0

# Path to FreeCAD AppImage (download via scripts/smoke_test_freecad.sh)
FREECAD_APPIMAGE_PATH=/data/workspace/freecad/FreeCAD.AppImage

# API server config
PORT=8000
LOG_LEVEL=INFO
RELOAD=false

# CORS origins (comma-separated, use * for dev)
CORS_ORIGINS=http://localhost:3000,https://cognitect.vercel.app

# Sentry error tracking. Unset locally is fine — api/main.py guards init on
# this being present, so the app starts cleanly without it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
